{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Content posts like jobs, scholarships, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "contentType": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "categoryId": { "type": "string" },
        "authorId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "slug", "contentType", "summary", "content", "categoryId", "authorId", "status", "createdAt", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Important notices and banners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "type"]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Educational material resources",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicName": { "type": "string" },
        "subject": { "type": "string" },
        "shortDescription": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "classLevel": { "type": "string" },
        "author": { "type": "string" },
        "language": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" }
      },
      "required": ["id", "topicName", "subject", "shortDescription", "detailedDescription", "classLevel", "author", "language", "fileUrl", "fileName", "fileType"]
    },
    "DigitalService": {
      "title": "DigitalService",
      "description": "Online service offerings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "shortDescription": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "icon": { "type": "string" },
        "eligibility": { "type": "string" },
        "process": { "type": "string" },
        "charges": { "type": "string" },
        "processingTime": { "type": "string" }
      },
      "required": ["id", "name", "category", "shortDescription", "detailedDescription", "icon", "eligibility", "process", "charges", "processingTime"]
    },
    "User": {
      "title": "User",
      "description": "Application user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "User booking appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "customerId": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "serviceId", "customerId", "date", "timeSlot", "status", "createdAt"]
    }
  },
  "firestore": {
    "posts": {
      "schema": "Post",
      "description": "Collection of all content posts"
    },
    "announcements": {
      "schema": "Announcement",
      "description": "Collection of announcements and banners"
    },
    "studyMaterials": {
      "schema": "StudyMaterial",
      "description": "Collection of study materials"
    },
    "digitalServices": {
      "schema": "DigitalService",
      "description": "Collection of digital services"
    },
    "users": {
      "schema": "User",
      "description": "Collection of application users"
    },
    "appointments": {
      "schema": "Appointment",
      "description": "Collection of bookings"
    }
  }
}
