{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Content posts like jobs, scholarships, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "contentType": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "categoryId": { "type": "string" },
        "authorId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "slug", "contentType", "summary", "content", "categoryId", "authorId", "status", "createdAt", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "Application user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "User booking appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "customerId": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "serviceId", "customerId", "date", "timeSlot", "status", "createdAt"]
    }
  },
  "firestore": {
    "posts": {
      "schema": "Post",
      "description": "Collection of all content posts"
    },
    "users": {
      "schema": "User",
      "description": "Collection of application users"
    },
    "appointments": {
      "schema": "Appointment",
      "description": "Collection of bookings"
    }
  }
}
