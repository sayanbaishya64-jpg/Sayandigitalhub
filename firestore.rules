rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Helper: Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Global Helper: Check if user is an admin or super admin or authenticated manager
    function isAdmin() {
      return isSignedIn();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
      
      match /super-admin-dashboard {
        allow read, write: if isSignedIn();
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /studyMaterials/{matId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /digitalServices/{srvId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /websiteSections/{secId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /templates/{tmplId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /availabilityRules/{ruleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /appointments/{aptId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read, write: if isSignedIn();
    }
    
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
