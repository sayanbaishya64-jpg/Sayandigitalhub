rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Helper: Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Global Helper: Check if user is a verified super admin
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' &&
             request.auth.token.email_verified == true;
    }
    
    // Global Helper: Check if user is an admin or super admin
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin') &&
             request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId; // Basic self-management
      
      // Super Admin protection
      match /super-admin-dashboard {
        allow read, write: if isSuperAdmin();
      }
    }

    match /posts/{postId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can create/edit content
    }
    
    match /{document=**} {
      allow read, write: if false; // Default deny
    }
  }
}
